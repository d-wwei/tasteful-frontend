{
  "$extensions": {
    "brand": "mongodb",
    "source": "LeafyGreen Design System (mongodb.design)",
    "aesthetic": "developer-focused data platform — dark ink surfaces, electric green accents, monospace precision",
    "key-characteristics": [
      "leafygreen-palette",
      "dark-ink-canvas",
      "developer-tooling",
      "document-database",
      "atlas-cloud-platform"
    ]
  },
  "color": {
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Primary light-mode background (LeafyGreen white)"
    },
    "surface-secondary": {
      "$value": "#F9FBFA",
      "$type": "color",
      "$description": "Secondary light surface (gray.light3) — cards, sidebars, code panels"
    },
    "surface-dark": {
      "$value": "#001E2B",
      "$type": "color",
      "$description": "Primary dark-mode background (LeafyGreen black / MDB Ink) — Atlas shell, dark panels"
    },
    "surface-dark-secondary": {
      "$value": "#112733",
      "$type": "color",
      "$description": "Secondary dark surface (gray.dark4) — elevated panels in dark mode"
    },
    "surface-dark-tertiary": {
      "$value": "#1C2D38",
      "$type": "color",
      "$description": "Tertiary dark surface (gray.dark3) — code editor background, hover states in dark mode"
    },
    "accent": {
      "$value": "#00ED64",
      "$type": "color",
      "$description": "Primary accent (green.base) — CTAs, active states, success indicators on dark surfaces"
    },
    "accent-dark": {
      "$value": "#00684A",
      "$type": "color",
      "$description": "Deep accent (green.dark2) — primary buttons on light surfaces, brand anchor"
    },
    "accent-hover": {
      "$value": "#00A35C",
      "$type": "color",
      "$description": "Accent hover (green.dark1) — interactive hover state"
    },
    "accent-light": {
      "$value": "#C0FAE6",
      "$type": "color",
      "$description": "Accent tint (green.light2) — subtle green backgrounds, selected row highlights"
    },
    "accent-subtle": {
      "$value": "#E3FCF7",
      "$type": "color",
      "$description": "Accent whisper (green.light3) — lightest green wash for banners, badges"
    },
    "text-primary": {
      "$value": "#001E2B",
      "$type": "color",
      "$description": "Primary text on light surfaces (LeafyGreen black / MDB Ink)"
    },
    "text-secondary": {
      "$value": "#5C6C75",
      "$type": "color",
      "$description": "Secondary text (gray.dark1) — descriptions, metadata, placeholders"
    },
    "text-disabled": {
      "$value": "#889397",
      "$type": "color",
      "$description": "Disabled text (gray.base) — inactive labels, disabled inputs"
    },
    "text-on-dark": {
      "$value": "#E8EDEB",
      "$type": "color",
      "$description": "Primary text on dark surfaces (gray.light2)"
    },
    "text-on-dark-secondary": {
      "$value": "#C1C7C6",
      "$type": "color",
      "$description": "Secondary text on dark surfaces (gray.light1)"
    },
    "text-on-accent": {
      "$value": "#001E2B",
      "$type": "color",
      "$description": "Text on green.base accent — dark ink for contrast on bright green"
    },
    "text-link": {
      "$value": "#016BF8",
      "$type": "color",
      "$description": "Link color (blue.base) — inline text links"
    },
    "text-code": {
      "$value": "#1C2D38",
      "$type": "color",
      "$description": "Code text (gray.dark3) — inline code, shell output"
    },
    "error": {
      "$value": "#DB3030",
      "$type": "color",
      "$description": "Error state (red.base) — validation errors, destructive actions"
    },
    "error-light": {
      "$value": "#FFEAE5",
      "$type": "color",
      "$description": "Error background (red.light3) — error banners, alert surfaces"
    },
    "success": {
      "$value": "#00684A",
      "$type": "color",
      "$description": "Success state (green.dark2) — confirmation, successful operations"
    },
    "success-light": {
      "$value": "#E3FCF7",
      "$type": "color",
      "$description": "Success background (green.light3) — success banners"
    },
    "warning": {
      "$value": "#FFC010",
      "$type": "color",
      "$description": "Warning state (yellow.base) — caution alerts, deprecation notices"
    },
    "warning-light": {
      "$value": "#FEF7DB",
      "$type": "color",
      "$description": "Warning background (yellow.light3) — warning banners"
    },
    "info": {
      "$value": "#016BF8",
      "$type": "color",
      "$description": "Info state (blue.base) — informational banners, focus rings"
    },
    "info-light": {
      "$value": "#E1F7FF",
      "$type": "color",
      "$description": "Info background (blue.light3) — info banners, selected states"
    },
    "border": {
      "$value": "#E8EDEB",
      "$type": "color",
      "$description": "Default border (gray.light2) — card borders, dividers"
    },
    "border-dark": {
      "$value": "#3D4F58",
      "$type": "color",
      "$description": "Border on dark surfaces (gray.dark2) — menu borders, dividers in dark mode"
    },
    "border-hover": {
      "$value": "#889397",
      "$type": "color",
      "$description": "Hover border (gray.base) — input focus, hovered card borders"
    },
    "focus-ring": {
      "$value": "#0498EC",
      "$type": "color",
      "$description": "Focus ring (blue.light1) — keyboard focus indicator"
    }
  },
  "typography": {
    "font-display": {
      "$value": "'MongoDB Value Serif', Georgia, serif",
      "$type": "fontFamily",
      "$description": "Display / marketing headlines — MongoDB Value Serif"
    },
    "font-body": {
      "$value": "'Euclid Circular A', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Body / UI font — Euclid Circular A (LeafyGreen primary)"
    },
    "font-code": {
      "$value": "'Source Code Pro', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
      "$type": "fontFamily",
      "$description": "Code / shell font — Source Code Pro (queries, JSON, shell output)"
    },
    "scale-display": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Display — marketing hero headlines (MongoDB Value Serif)"
    },
    "scale-h1": {
      "$value": "36px",
      "$type": "dimension",
      "$description": "H1 — page titles"
    },
    "scale-h2": {
      "$value": "28px",
      "$type": "dimension",
      "$description": "H2 — section headings"
    },
    "scale-h3": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "H3 — subsection headings"
    },
    "scale-body1": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Body 1 — primary reading text"
    },
    "scale-body2": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "Body 2 — secondary text, descriptions, table cells"
    },
    "scale-caption": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Caption — labels, metadata, badges"
    },
    "scale-overline": {
      "$value": "11px",
      "$type": "dimension",
      "$description": "Overline — category labels, eyebrow text"
    },
    "scale-code": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "Code — Source Code Pro for queries and JSON"
    },
    "line-height-tight": {
      "$value": "1.25",
      "$type": "number",
      "$description": "Tight — headings, display"
    },
    "line-height-normal": {
      "$value": "1.50",
      "$type": "number",
      "$description": "Normal — body text"
    },
    "line-height-relaxed": {
      "$value": "1.625",
      "$type": "number",
      "$description": "Relaxed — documentation text, long-form reading"
    },
    "line-height-code": {
      "$value": "1.60",
      "$type": "number",
      "$description": "Code — monospace blocks with room for line numbers"
    },
    "weight-regular": {
      "$value": "400",
      "$type": "number",
      "$description": "Regular — body text, descriptions"
    },
    "weight-medium": {
      "$value": "500",
      "$type": "number",
      "$description": "Medium — buttons, nav links, labels"
    },
    "weight-semibold": {
      "$value": "600",
      "$type": "number",
      "$description": "Semibold — headings, emphasis"
    },
    "weight-bold": {
      "$value": "700",
      "$type": "number",
      "$description": "Bold — display headlines, MongoDB Value Serif"
    }
  },
  "spacing": {
    "unit": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Base unit — LeafyGreen uses 4px baseline grid"
    },
    "2xs": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Micro — focus ring offset, hairline gaps"
    },
    "xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Extra small — inline icon gaps, tight padding"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Small — button icon gap, badge padding"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Medium — input padding, card inner gaps"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Large — card padding, form field spacing"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Extra large — section content padding"
    },
    "2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Double extra large — card body padding, group spacing"
    },
    "3xl": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Triple extra large — section vertical padding"
    },
    "section-gap": {
      "$value": "80px",
      "$type": "dimension",
      "$description": "Section spacing — between major page sections"
    },
    "container-max": {
      "$value": "1200px",
      "$type": "dimension",
      "$description": "Max container width"
    },
    "sidebar-width": {
      "$value": "260px",
      "$type": "dimension",
      "$description": "Sidebar width — docs nav, Atlas left panel"
    }
  },
  "border": {
    "radius-none": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "No radius — table cells, code blocks"
    },
    "radius-sm": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Small — badges, inline code, chips"
    },
    "radius-md": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Medium — buttons, inputs, dropdowns (LeafyGreen default)"
    },
    "radius-lg": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Large — cards, modals, popovers"
    },
    "radius-xl": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Extra large — featured cards, hero containers"
    },
    "radius-pill": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Pill — tags, toggle indicators"
    }
  },
  "shadow": {
    "level-0": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent"
        }
      ],
      "$type": "shadow",
      "$description": "Flat — default, no elevation"
    },
    "level-1": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "10px",
          "spread": "-4px",
          "color": "rgba(0,30,43,0.08)"
        }
      ],
      "$type": "shadow",
      "$description": "Subtle — cards, dropdowns at rest"
    },
    "level-2": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "20px",
          "spread": "-4px",
          "color": "rgba(0,30,43,0.15)"
        }
      ],
      "$type": "shadow",
      "$description": "Elevated — modals, popovers, floating menus"
    },
    "level-3": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "30px",
          "spread": "-4px",
          "color": "rgba(0,30,43,0.20)"
        }
      ],
      "$type": "shadow",
      "$description": "Prominent — toasts, tooltips, command palettes"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "100ms",
      "$type": "duration",
      "$description": "Fast — icon transitions, toggle states"
    },
    "duration-normal": {
      "$value": "150ms",
      "$type": "duration",
      "$description": "Normal — button hover, focus ring"
    },
    "duration-slow": {
      "$value": "300ms",
      "$type": "duration",
      "$description": "Slow — panel expand/collapse, modal open"
    },
    "easing-default": {
      "$value": [
        0.15,
        0,
        0.35,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Default ease — snappy in, smooth out"
    },
    "easing-enter": {
      "$value": [
        0,
        0,
        0.35,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Enter — elements appearing"
    },
    "easing-exit": {
      "$value": [
        0.15,
        0,
        1,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Exit — elements disappearing"
    },
    "reduced-duration": {
      "$value": "0.01ms",
      "$type": "duration",
      "$description": "Near-zero duration for prefers-reduced-motion. Applied via media query."
    },
    "reduced-easing": {
      "$value": [
        0,
        0,
        1,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Linear easing for reduced motion -- no spring/bounce."
    }
  },
  "breakpoint": {
    "mobile": {
      "$value": "640px",
      "$type": "dimension",
      "$description": "Mobile"
    },
    "tablet": {
      "$value": "768px",
      "$type": "dimension",
      "$description": "Tablet"
    },
    "desktop": {
      "$value": "1024px",
      "$type": "dimension",
      "$description": "Desktop"
    },
    "wide": {
      "$value": "1440px",
      "$type": "dimension",
      "$description": "Wide — Atlas full-width dashboard"
    }
  }
}
