{
  "$extensions": {
    "brand": "pinterest",
    "source": "gestalt-design-system",
    "aesthetic": "warm visual discovery -- clean white canvas, restrained red accent, soft rounded geometry, content-first masonry grid",
    "key-characteristics": [
      "pinterest-red-accent",
      "masonry-grid-layout",
      "rounded-corners-16px",
      "content-first-imagery",
      "gestalt-design-system"
    ]
  },
  "color": {
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Primary page background -- pure white canvas that lets visual content dominate"
    },
    "surface-secondary": {
      "$value": "#f9f9f9",
      "$type": "color",
      "$description": "Secondary surface -- roboflow-50, subtle off-white for cards on white bg"
    },
    "surface-tertiary": {
      "$value": "#f1f1f1",
      "$type": "color",
      "$description": "Tertiary surface -- roboflow-100, input fields, search bar backgrounds"
    },
    "surface-wash": {
      "$value": "#e9e9e9",
      "$type": "color",
      "$description": "Wash surface -- roboflow-200, dividers, inactive tab backgrounds"
    },
    "accent": {
      "$value": "#e60023",
      "$type": "color",
      "$description": "Pinterest Red (pushpin-700) -- primary brand color, Save button, CTAs only"
    },
    "accent-hover": {
      "$value": "#cc0000",
      "$type": "color",
      "$description": "Pinterest Red hover (pushpin-800) -- darkened for hover/active"
    },
    "accent-light": {
      "$value": "#ffe0e0",
      "$type": "color",
      "$description": "Red wash (pushpin-300) -- light tint for selected/active backgrounds"
    },
    "text-primary": {
      "$value": "#111111",
      "$type": "color",
      "$description": "Primary text -- Gestalt uses near-black #111, not #000 or #333"
    },
    "text-secondary": {
      "$value": "#767676",
      "$type": "color",
      "$description": "Secondary text (roboflow-600) -- metadata, descriptions, timestamps"
    },
    "text-tertiary": {
      "$value": "#a5a5a5",
      "$type": "color",
      "$description": "Tertiary text (roboflow-500) -- placeholders, disabled states"
    },
    "text-on-accent": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "White text on red accent surfaces"
    },
    "text-link": {
      "$value": "#0074e8",
      "$type": "color",
      "$description": "Link blue (skycicle-800) -- hyperlinks and secondary interactive elements"
    },
    "error": {
      "$value": "#e60023",
      "$type": "color",
      "$description": "Error state -- shares pushpin-700 red, reinforces red = attention"
    },
    "success": {
      "$value": "#008753",
      "$type": "color",
      "$description": "Success state (matchacado-800) -- confirmations, completion indicators"
    },
    "warning": {
      "$value": "#bd5b00",
      "$type": "color",
      "$description": "Warning state (firetini-800) -- cautionary messages"
    },
    "info": {
      "$value": "#0074e8",
      "$type": "color",
      "$description": "Informational state (skycicle-800) -- tips, contextual information"
    },
    "border": {
      "$value": "#cdcdcd",
      "$type": "color",
      "$description": "Default border (roboflow-400) -- subtle containment for cards"
    },
    "border-light": {
      "$value": "#e9e9e9",
      "$type": "color",
      "$description": "Light border (roboflow-200) -- dividers, separators"
    },
    "overlay": {
      "$value": "rgba(0, 0, 0, 0.5)",
      "$type": "color",
      "$description": "Modal/overlay backdrop -- standard 50% black overlay"
    },
    "pin-overlay-gradient": {
      "$value": "linear-gradient(transparent 60%, rgba(0, 0, 0, 0.6))",
      "$type": "gradient",
      "$description": "Pin image overlay gradient -- bottom fade for text legibility on images"
    }
  },
  "typography": {
    "font-display": {
      "$value": "'Pinterest Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Display and heading font -- Pinterest Sans with system fallback stack"
    },
    "font-body": {
      "$value": "'Pinterest Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Body and UI font -- same family, weight differentiates hierarchy"
    },
    "font-code": {
      "$value": "SFMono-Medium, 'SF Mono', 'Segoe UI Mono', 'Roboto Mono', 'Ubuntu Mono', Menlo, Consolas, Courier, monospace",
      "$type": "fontFamily",
      "$description": "Monospace for code contexts"
    },
    "scale-display": {
      "$value": "36px",
      "$type": "dimension",
      "$description": "Display / Hero headline (font-600 in Gestalt)"
    },
    "scale-heading": {
      "$value": "28px",
      "$type": "dimension",
      "$description": "Page-level heading (font-500)"
    },
    "scale-subheading": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "Section subheading (font-400)"
    },
    "scale-base": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Body text (font-300)"
    },
    "scale-caption": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "Caption and metadata (font-200)"
    },
    "scale-small": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Small text, badges, labels (font-100)"
    },
    "line-height-tight": {
      "$value": "1.2",
      "$type": "number",
      "$description": "Tight -- headings and display text"
    },
    "line-height-normal": {
      "$value": "1.4",
      "$type": "number",
      "$description": "Normal -- body text, card descriptions"
    },
    "line-height-relaxed": {
      "$value": "1.5",
      "$type": "number",
      "$description": "Relaxed -- long-form content, accessibility contexts"
    },
    "weight-normal": {
      "$value": "400",
      "$type": "number",
      "$description": "Normal -- body text, descriptions"
    },
    "weight-semibold": {
      "$value": "600",
      "$type": "number",
      "$description": "Semibold -- subheadings, button labels, emphasis"
    },
    "weight-bold": {
      "$value": "700",
      "$type": "number",
      "$description": "Bold -- display headings, hero text, strong emphasis"
    }
  },
  "spacing": {
    "unit": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Base unit -- Gestalt uses a 4px grid, NOT 8px"
    },
    "xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Extra small (space-100)"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Small (space-200)"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Medium (space-300)"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Large (space-400)"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Extra large (space-600)"
    },
    "2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Double extra large (space-800)"
    },
    "3xl": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Triple extra large (space-1200)"
    },
    "masonry-gutter": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Masonry grid gutter -- standard gap between pins"
    },
    "section-gap": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "Section spacing -- vertical rhythm between page sections"
    },
    "container-max": {
      "$value": "1200px",
      "$type": "dimension",
      "$description": "Max container width"
    }
  },
  "border": {
    "radius-sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Small radius (rounding-200) -- buttons, inputs, small cards"
    },
    "radius-standard": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Standard radius (rounding-400) -- pin cards, modals, sheets"
    },
    "radius-lg": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Large radius (rounding-600) -- featured containers, hero cards"
    },
    "radius-xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Extra large radius (rounding-800) -- search bar, hero elements"
    },
    "radius-pill": {
      "$value": "999px",
      "$type": "dimension",
      "$description": "Pill shape -- tags, chips, toggle buttons"
    },
    "radius-circle": {
      "$value": "50%",
      "$type": "dimension",
      "$description": "Circle -- avatars, icon buttons"
    }
  },
  "shadow": {
    "level-0": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent"
        }
      ],
      "$type": "shadow",
      "$description": "Flat -- default pin card state, no elevation"
    },
    "level-1": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.08)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.06)"
        }
      ],
      "$type": "shadow",
      "$description": "Subtle -- pin card hover, raised elements"
    },
    "level-2": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "16px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.12)"
        }
      ],
      "$type": "shadow",
      "$description": "Elevated -- modals, sheets, flyouts"
    },
    "level-3": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "32px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.16)"
        }
      ],
      "$type": "shadow",
      "$description": "High -- tooltips, popovers"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "100ms",
      "$type": "duration",
      "$description": "Fast -- micro-interactions, icon state changes"
    },
    "duration-normal": {
      "$value": "200ms",
      "$type": "duration",
      "$description": "Normal -- button hover, card hover elevation"
    },
    "duration-slow": {
      "$value": "300ms",
      "$type": "duration",
      "$description": "Slow -- modal open/close, sheet transitions"
    },
    "easing-default": {
      "$value": [0.25, 0.1, 0.25, 1.0],
      "$type": "cubicBezier",
      "$description": "Ease-out -- standard for most interactions"
    },
    "easing-enter": {
      "$value": [0.0, 0.0, 0.2, 1.0],
      "$type": "cubicBezier",
      "$description": "Enter -- elements appearing on screen"
    },
    "easing-exit": {
      "$value": [0.4, 0.0, 1.0, 1.0],
      "$type": "cubicBezier",
      "$description": "Exit -- elements leaving screen"
    }
  },
  "breakpoint": {
    "sm": {
      "$value": "576px",
      "$type": "dimension",
      "$description": "Small -- compact mobile"
    },
    "md": {
      "$value": "768px",
      "$type": "dimension",
      "$description": "Medium -- tablet"
    },
    "lg": {
      "$value": "1024px",
      "$type": "dimension",
      "$description": "Large -- desktop"
    },
    "xl": {
      "$value": "1312px",
      "$type": "dimension",
      "$description": "Extra large -- wide desktop, max masonry columns"
    }
  },
  "masonry": {
    "column-width": {
      "$value": "236px",
      "$type": "dimension",
      "$description": "Standard pin card width in masonry grid"
    },
    "gutter": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Gap between pins in masonry layout"
    },
    "columns-mobile": {
      "$value": "2",
      "$type": "number",
      "$description": "Masonry columns on mobile (<576px)"
    },
    "columns-tablet": {
      "$value": "3",
      "$type": "number",
      "$description": "Masonry columns on tablet (576-1024px)"
    },
    "columns-desktop": {
      "$value": "5",
      "$type": "number",
      "$description": "Masonry columns on desktop (1024px+)"
    },
    "columns-wide": {
      "$value": "7",
      "$type": "number",
      "$description": "Masonry columns on wide desktop (1312px+)"
    }
  }
}
