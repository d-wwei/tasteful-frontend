    "radius-card": { "$value": "8px", "$type": "dimension", "$description": "Cards, dropdowns, popovers" },
    "radius-panel": { "$value": "12px", "$type": "dimension", "$description": "Panels, featured cards, section containers, top-rounded images" },
    "radius-lg": { "$value": "22px", "$type": "dimension", "$description": "Large panel elements" },
    "radius-pill": { "$value": "9999px", "$type": "dimension", "$description": "Chips, filter pills, status tags — full pill shape" },
    "radius-circle": { "$value": "50%", "$type": "dimension", "$description": "Icon buttons, avatars, status dots" },
    "width-default": { "$value": "1px", "$type": "dimension", "$description": "Standard border width throughout the system" }
  },

  "shadow": {
    "level-0-flat": {
      "$value": [],
      "$type": "shadow",
      "$description": "Level 0 — No shadow. Page background, deepest canvas on #010102"
    },
    "level-1-subtle": {
      "$value": [
        { "offsetX": "0px", "offsetY": "1.2px", "blur": "0px", "spread": "0px", "color": "rgba(0,0,0,0.03)" }
      ],
      "$type": "shadow",
      "$description": "Level 1 — Toolbar buttons, micro-elevation"
    },
    "level-2b-inset": {
      "$value": [
        { "offsetX": "0px", "offsetY": "0px", "blur": "12px", "spread": "0px", "color": "rgba(0,0,0,0.2)", "inset": true }
      ],
      "$type": "shadow",
      "$description": "Level 2b — Recessed panels, inner shadow. Unique sunken effect for dimensional depth"
    },
    "level-3-ring": {
      "$value": [
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "rgba(0,0,0,0.2)" }
      ],
      "$type": "shadow",
      "$description": "Level 3 — Border-as-shadow technique for cards and containers"
    },
    "level-4-elevated": {
      "$value": [
        { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "color": "rgba(0,0,0,0.4)" }
      ],
      "$type": "shadow",
      "$description": "Level 4 — Floating elements, dropdowns, screenshot shadows"
    },
    "level-5-dialog": {
      "$value": [
        { "offsetX": "0px", "offsetY": "8px", "blur": "2px", "spread": "0px", "color": "rgba(0,0,0,0)" },
        { "offsetX": "0px", "offsetY": "5px", "blur": "2px", "spread": "0px", "color": "rgba(0,0,0,0.01)" },
        { "offsetX": "0px", "offsetY": "3px", "blur": "2px", "spread": "0px", "color": "rgba(0,0,0,0.04)" },
        { "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px", "color": "rgba(0,0,0,0.07)" },
        { "offsetX": "0px", "offsetY": "0px", "blur": "1px", "spread": "0px", "color": "rgba(0,0,0,0.08)" }
      ],
      "$type": "shadow",
      "$description": "Level 5 — Multi-layer stack for popovers, command palette, modals"
    },
    "level-6-focus": {
      "$value": [
        { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "rgba(0,0,0,0.1)" }
      ],
      "$type": "shadow",
      "$description": "Level 6 — Keyboard focus on interactive elements (additional layers may apply)"
    }
  },

  "motion": {
    "duration-fast": {
      "$value": "150ms",
      "$type": "duration",
      "$description": "Quick micro-interactions — hover states, opacity changes"
    },
    "duration-normal": {
      "$value": "200ms",
      "$type": "duration",
      "$description": "Standard transitions — button states, panel reveals"
    },
    "duration-slow": {
      "$value": "300ms",
      "$type": "duration",
      "$description": "Deliberate transitions — modal entrance, page transitions"
    },
    "easing-default": {
      "$value": [0.16, 1, 0.3, 1],
      "$type": "cubicBezier",
      "$description": "Spring-like entrance curve — snappy with natural deceleration"
    },
    "easing-exit": {
      "$value": [0.4, 0, 1, 1],
      "$type": "cubicBezier",
      "$description": "Quick exit curve — accelerates out of view"
    }
  },

  "breakpoint": {
    "mobile-sm": { "$value": "600px", "$type": "dimension", "$description": "Small mobile — single column, compact padding" },
    "mobile": { "$value": "640px", "$type": "dimension", "$description": "Standard mobile layout" },
    "tablet": { "$value": "768px", "$type": "dimension", "$description": "Two-column grids begin, navigation collapses" },
    "desktop-sm": { "$value": "1024px", "$type": "dimension", "$description": "Full card grids, expanded padding" },
    "desktop": { "$value": "1280px", "$type": "dimension", "$description": "Standard desktop, full navigation, generous margins" }
  }
}
