{
  "$extensions": {
    "brand": "linear",
    "source": "awesome-design-md",
    "aesthetic": "darkness as native medium, precision engineering",
    "key-characteristics": [
      "dark-mode-first",
      "signature-weight-510",
      "violet-accent-system",
      "inter-variable-cv01-ss03",
      "luminance-stacking-elevation",
      "semi-transparent-white-borders"
    ]
  },

  "color": {
    "surface": {
      "$value": "#08090a",
      "$type": "color",
      "$description": "Primary background — dark canvas from which content emerges"
    },
    "surface-subtle": {
      "$value": "#0f1011",
      "$type": "color",
      "$description": "Subtle surface variation — panel and sidebar backgrounds"
    },
    "accent": {
      "$value": "#5e6ad2",
      "$type": "color",
      "$description": "Primary brand accent — Linear indigo, CTAs and interactive highlights"
    },
    "error": {
      "$value": "#e5484d",
      "$type": "color",
      "$description": "Error and destructive action state — warm red"
    },
    "success": {
      "$value": "#27a644",
      "$type": "color",
      "$description": "Success and confirmation state — green"
    },
    "surface-marketing-black": {
      "$value": "#010102",
      "$type": "color",
      "$description": "Deepest background — hero sections, marketing pages. Near-pure black with imperceptible blue-cool undertone"
    },
    "surface-marketing": {
      "$value": "#08090a",
      "$type": "color",
      "$description": "Primary marketing background — the dark canvas from which content emerges"
    },
    "surface-panel": {
      "$value": "#0f1011",
      "$type": "color",
      "$description": "Sidebar and panel backgrounds. One step up from marketing black"
    },
    "surface-elevated": {
      "$value": "#191a1b",
      "$type": "color",
      "$description": "Elevated surface areas — card backgrounds, dropdowns, Level 3"
    },
    "surface-secondary": {
      "$value": "#28282c",
      "$type": "color",
      "$description": "Lightest dark surface — hover states, slightly elevated components"
    },
    "surface-translucent-lowest": {
      "$value": "rgba(255,255,255,0.02)",
      "$type": "color",
      "$description": "Near-invisible translucent surface — ghost button backgrounds, card defaults"
    },
    "surface-translucent-subtle": {
      "$value": "rgba(255,255,255,0.03)",
      "$type": "color",
      "$description": "Barely visible translucent surface — icon button backgrounds"
    },
    "surface-translucent-low": {
      "$value": "rgba(255,255,255,0.04)",
      "$type": "color",
      "$description": "Subtle translucent surface — subtle button backgrounds"
    },
    "surface-translucent-mid": {
      "$value": "rgba(255,255,255,0.05)",
      "$type": "color",
      "$description": "Standard translucent surface — toolbar buttons, badges, card hover"
    },

    "text-primary": {
      "$value": "#f7f8f8",
      "$type": "color",
      "$description": "Near-white with barely-warm cast — default text. Not pure white, prevents eye strain on dark backgrounds"
    },
    "text-secondary": {
      "$value": "#d0d6e0",
      "$type": "color",
      "$description": "Cool silver-gray — body text, descriptions, secondary content"
    },
    "text-tertiary": {
      "$value": "#8a8f98",
      "$type": "color",
      "$description": "Muted gray — placeholders, metadata, de-emphasized content"
    },
    "text-quaternary": {
      "$value": "#62666d",
      "$type": "color",
      "$description": "Most subdued text — timestamps, disabled states, subtle labels"
    },
    "text-ghost-button": {
      "$value": "#e2e4e7",
      "$type": "color",
      "$description": "Near-white text for ghost buttons"
    },
    "text-on-brand": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Pure white text on brand indigo CTA buttons"
    },

    "accent-brand-indigo": {
      "$value": "#5e6ad2",
      "$type": "color",
      "$description": "Primary brand color — CTA button backgrounds, brand marks, key interactive surfaces"
    },
    "accent-violet": {
      "$value": "#7170ff",
      "$type": "color",
      "$description": "Brighter variant for interactive elements — links, active states, selected items"
    },
    "accent-hover": {
      "$value": "#828fff",
      "$type": "color",
      "$description": "Lighter, more saturated variant for hover states on accent elements"
    },
    "accent-security-lavender": {
      "$value": "#7a7fad",
      "$type": "color",
      "$description": "Muted indigo for security-related UI elements"
    },

    "status-green": {
      "$value": "#27a644",
      "$type": "color",
      "$description": "Primary success/active status — in-progress indicators"
    },
    "status-emerald": {
      "$value": "#10b981",
      "$type": "color",
      "$description": "Secondary success — pill badges, completion states"
    },

    "border-primary": {
      "$value": "#23252a",
      "$type": "color",
      "$description": "Solid dark border for prominent separations"
    },
    "border-secondary": {
      "$value": "#34343a",
      "$type": "color",
      "$description": "Slightly lighter solid border"
    },
    "border-tertiary": {
      "$value": "#3e3e44",
      "$type": "color",
      "$description": "Lightest solid border variant"
    },
    "border-subtle": {
      "$value": "rgba(255,255,255,0.05)",
      "$type": "color",
      "$description": "Ultra-subtle semi-transparent border — the default for most elements"
    },
    "border-standard": {
      "$value": "rgba(255,255,255,0.08)",
      "$type": "color",
      "$description": "Standard semi-transparent border for cards, inputs, code blocks"
    },
    "border-ghost-button": {
      "$value": "rgb(36,40,44)",
      "$type": "color",
      "$description": "Ghost button border"
    },
    "border-pill": {
      "$value": "rgb(35,37,42)",
      "$type": "color",
      "$description": "Pill and neutral badge border"
    },
    "line-tint": {
      "$value": "#141516",
      "$type": "color",
      "$description": "Nearly invisible divider line for subtlest divisions"
    },
    "line-tertiary": {
      "$value": "#18191a",
      "$type": "color",
      "$description": "Slightly more visible divider line"
    },

    "overlay-primary": {
      "$value": "rgba(0,0,0,0.85)",
      "$type": "color",
      "$description": "Modal/dialog backdrop — extremely dark for focus isolation"
    },

    "light-background": {
      "$value": "#f7f8f8",
      "$type": "color",
      "$description": "Page background in light mode contexts"
    },
    "light-surface": {
      "$value": "#f3f4f5",
      "$type": "color",
      "$description": "Subtle surface tinting in light mode"
    },
    "light-surface-alt": {
      "$value": "#f5f6f7",
      "$type": "color",
      "$description": "Alternative surface tinting in light mode"
    },
    "light-border": {
      "$value": "#d0d6e0",
      "$type": "color",
      "$description": "Visible border in light mode contexts"
    },
    "light-border-alt": {
      "$value": "#e6e6e6",
      "$type": "color",
      "$description": "Alternative lighter border in light mode"
    },
    "light-card-surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Card surfaces and highlights in light mode"
    }
