  "typography": {
    "font-primary": {
      "$value": "Inter Variable, SF Pro Display, -apple-system, system-ui, Segoe UI, Roboto, Oxygen, Ubuntu, Cantarell, Open Sans, Helvetica Neue, sans-serif",
      "$type": "fontFamily",
      "$description": "Primary typeface — Inter Variable with cv01/ss03 OpenType features for geometric alternates"
    },
    "font-mono": {
      "$value": "Berkeley Mono, ui-monospace, SF Mono, Menlo, monospace",
      "$type": "fontFamily",
      "$description": "Monospace typeface for code and technical labels"
    },
    "opentype-features": {
      "$value": "\"cv01\", \"ss03\"",
      "$type": "fontFeature",
      "$description": "Required OpenType features — cv01 (single-story a), ss03 (cleaner geometric letterforms). Non-negotiable for Linear identity"
    },

    "weight-light": {
      "$value": 300,
      "$type": "number",
      "$description": "Light weight — deliberately de-emphasized contexts only"
    },
    "weight-regular": {
      "$value": 400,
      "$type": "number",
      "$description": "Regular weight — reading text, body copy"
    },
    "weight-signature": {
      "$value": 510,
      "$type": "number",
      "$description": "Linear's signature weight — between regular (400) and medium (500). Default emphasis for UI text, navigation, labels"
    },
    "weight-semibold": {
      "$value": 590,
      "$type": "number",
      "$description": "Semibold — strong emphasis, announcements. Maximum weight in the system (no 700 bold)"
    },

    "scale-display-xl": { "$value": "72px", "$type": "dimension", "$description": "4.50rem — Hero headlines, maximum impact" },
    "scale-display-lg": { "$value": "64px", "$type": "dimension", "$description": "4.00rem — Secondary hero text" },
    "scale-display": { "$value": "48px", "$type": "dimension", "$description": "3.00rem — Section headlines" },
    "scale-h1": { "$value": "32px", "$type": "dimension", "$description": "2.00rem — Major section titles" },
    "scale-h2": { "$value": "24px", "$type": "dimension", "$description": "1.50rem — Sub-section headings" },
    "scale-h3": { "$value": "20px", "$type": "dimension", "$description": "1.25rem — Feature titles, card headers" },
    "scale-body-lg": { "$value": "18px", "$type": "dimension", "$description": "1.13rem — Introduction text, feature descriptions" },
    "scale-body-emphasis": { "$value": "17px", "$type": "dimension", "$description": "1.06rem — Emphasized body, sub-headings in content" },
    "scale-body": { "$value": "16px", "$type": "dimension", "$description": "1.00rem — Standard reading text" },
    "scale-small": { "$value": "15px", "$type": "dimension", "$description": "0.94rem — Secondary body text" },
    "scale-caption-lg": { "$value": "14px", "$type": "dimension", "$description": "0.88rem — Sub-labels, category headers, mono body" },
    "scale-caption": { "$value": "13px", "$type": "dimension", "$description": "0.81rem — Metadata, timestamps, navigation links" },
    "scale-label": { "$value": "12px", "$type": "dimension", "$description": "0.75rem — Button text, small labels, toolbar text" },
    "scale-micro": { "$value": "11px", "$type": "dimension", "$description": "0.69rem — Tiny labels" },
    "scale-tiny": { "$value": "10px", "$type": "dimension", "$description": "0.63rem — Overline text, status dots, sometimes uppercase" },

    "tracking-display-xl": { "$value": "-1.584px", "$type": "dimension", "$description": "Letter-spacing at 72px — aggressive compression" },
    "tracking-display-lg": { "$value": "-1.408px", "$type": "dimension", "$description": "Letter-spacing at 64px" },
    "tracking-display": { "$value": "-1.056px", "$type": "dimension", "$description": "Letter-spacing at 48px" },
    "tracking-h1": { "$value": "-0.704px", "$type": "dimension", "$description": "Letter-spacing at 32px" },
    "tracking-h2": { "$value": "-0.288px", "$type": "dimension", "$description": "Letter-spacing at 24px" },
    "tracking-h3": { "$value": "-0.24px", "$type": "dimension", "$description": "Letter-spacing at 20px" },
    "tracking-body-lg": { "$value": "-0.165px", "$type": "dimension", "$description": "Letter-spacing at 18px and 15px" },
    "tracking-caption-lg": { "$value": "-0.182px", "$type": "dimension", "$description": "Letter-spacing at 14px" },
    "tracking-caption": { "$value": "-0.13px", "$type": "dimension", "$description": "Letter-spacing at 13px" },
    "tracking-tiny": { "$value": "-0.15px", "$type": "dimension", "$description": "Letter-spacing at 10px" },
    "tracking-normal": { "$value": "0px", "$type": "dimension", "$description": "Normal letter-spacing — body (16px) and below where not specified" },

    "line-height-display": { "$value": 1.00, "$type": "number", "$description": "Tight — display and hero headlines (48px+)" },
    "line-height-h1": { "$value": 1.13, "$type": "number", "$description": "Tight — major section titles (32px)" },
    "line-height-heading": { "$value": 1.33, "$type": "number", "$description": "Standard heading line-height (20px–24px)" },
    "line-height-body": { "$value": 1.50, "$type": "number", "$description": "Standard body text, captions, labels" },
    "line-height-relaxed": { "$value": 1.60, "$type": "number", "$description": "Relaxed — body large, small text, comfortable reading" },
    "line-height-label": { "$value": 1.40, "$type": "number", "$description": "Labels, micro text, mono labels" },
    "line-height-small-light": { "$value": 1.47, "$type": "number", "$description": "De-emphasized body at 15px weight 300" },
    "line-height-link-medium": { "$value": 2.67, "$type": "number", "$description": "Spaced navigation links at 15px weight 510" },

