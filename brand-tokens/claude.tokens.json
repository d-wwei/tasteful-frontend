    },
    "2xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Micro spacing"
    },
    "xs": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Extra small spacing"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Small spacing — matches base unit"
    },
    "sm-plus": {
      "$value": "10px",
      "$type": "dimension",
      "$description": "Between small and medium"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Medium spacing — common button padding"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Large spacing — balanced button padding"
    },
    "xl": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "Extra large spacing"
    },
    "2xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Card internal padding lower bound"
    },
    "3xl": {
      "$value": "30px",
      "$type": "dimension",
      "$description": "Largest scale increment"
    },
    "4xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Card internal padding upper bound"
    },
    "section-gap-sm": {
      "$value": "80px",
      "$type": "dimension",
      "$description": "Minimum vertical spacing between major sections"
    },
    "section-gap-lg": {
      "$value": "120px",
      "$type": "dimension",
      "$description": "Maximum vertical spacing between major sections"
    },
    "page-margin-desktop": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "Page margin on desktop (inferred from editorial pacing)"
    },
    "page-margin-mobile": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "Page margin on mobile"
    },
    "container-max": {
      "$value": "1200px",
      "$type": "dimension",
      "$description": "Maximum container width, centered"
    }
