  "border": {
    "radius-sharp": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Minimal inline elements"
    },
    "radius-subtle": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Small buttons, secondary interactive elements"
    },
    "radius-comfortable": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Standard buttons, cards, containers — the workhorse radius"
    },
    "radius-generous": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Primary buttons, input fields, nav elements"
    },
    "radius-lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Featured containers, video players, tab lists"
    },
    "radius-xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Tag-like elements, highlighted containers"
    },
    "radius-2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Hero containers, embedded media, large cards"
    },
    "radius-full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Fully rounded pill shape"
    }
  },
  "shadow": {
    "level-0": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent"
        }
      ],
      "$type": "shadow",
      "$description": "Flat — no shadow, no border. Parchment background, inline text."
    },
    "level-1": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#f0eee6"
        }
      ],
      "$type": "shadow",
      "$description": "Contained — 1px ring in border cream for standard cards and sections (light theme)"
    },
    "level-1-dark": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#30302e"
        }
      ],
      "$type": "shadow",
      "$description": "Contained — 1px ring in dark surface for cards and sections (dark theme)"
    },
    "level-2": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#d1cfc5"
        }
      ],
      "$type": "shadow",
      "$description": "Ring — warm gray ring shadow for interactive cards, buttons, hover states"
    },
    "level-2-deep": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#c2c0b6"
        }
      ],
      "$type": "shadow",
      "$description": "Ring deep — deeper warm ring for active/pressed states"
    },
    "level-3": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "24px",
          "spread": "0px",
          "color": "rgba(44,36,24,0.05)"
        }
      ],
      "$type": "shadow",
      "$description": "Whisper — barely visible lift for elevated feature cards and product screenshots"
    },
    "level-4": {
      "$value": [
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "rgba(44,36,24,0.15)"
        }
      ],
      "$type": "shadow",
      "$description": "Inset — inset ring at 15% opacity for active/pressed button states"
    },
    "button-sand": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "#e8e6dc"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#d1cfc5"
        }
      ],
      "$type": "shadow",
      "$description": "Composite ring shadow for warm sand secondary button"
    },
    "button-brand": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "#c96442"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#c96442"
        }
      ],
      "$type": "shadow",
      "$description": "Composite ring shadow for terracotta brand CTA button"
    },
    "button-dark": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "#30302e"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#30302e"
        }
      ],
      "$type": "shadow",
      "$description": "Composite ring shadow for dark charcoal button"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "150ms",
      "$type": "duration",
      "$description": "Quick micro-interactions — hover state transitions"
    },
    "duration-normal": {
      "$value": "200ms",
      "$type": "duration",
      "$description": "Standard transitions — button presses, focus rings"
    },
    "duration-slow": {
      "$value": "300ms",
      "$type": "duration",
      "$description": "Deliberate transitions — section reveals, card expansions"
    },
    "easing-default": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Spring-like entrance — unhurried, literary pacing"
    },
    "easing-exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Quick exit — clean departure without lingering"
    },
    "reduced-duration": {
      "$value": "0.01ms",
      "$type": "duration",
      "$description": "Near-zero duration for prefers-reduced-motion. Applied via media query."
    },
    "reduced-easing": {
      "$value": [
        0,
        0,
        1,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Linear easing for reduced motion -- no spring/bounce."
    }
  },
  "breakpoint": {
    "sm-mobile": {
      "$value": "479px",
      "$type": "dimension",
      "$description": "Small mobile — stacked layout, compact typography"
    },
    "mobile": {
      "$value": "640px",
      "$type": "dimension",
      "$description": "Mobile — single column, hamburger nav, reduced headings"
    },
    "lg-mobile": {
      "$value": "767px",
      "$type": "dimension",
      "$description": "Large mobile — slightly wider content area"
    },
    "tablet": {
      "$value": "768px",
      "$type": "dimension",
      "$description": "Tablet — 2-column grids begin, condensed nav"
    },
    "desktop": {
      "$value": "992px",
      "$type": "dimension",
      "$description": "Desktop — full multi-column layout, expanded nav, max hero typography"
    }
  }
}
