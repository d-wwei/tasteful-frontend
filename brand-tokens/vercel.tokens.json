  "shadow": {
    "level-0": {
      "$value": "none",
      "$type": "string",
      "$description": "Flat — no shadow. Page background, text blocks"
    },
    "level-1-ring": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.08)"
        }
      ],
      "$type": "shadow",
      "$description": "Shadow-as-border — the signature technique replacing traditional CSS borders"
    },
    "level-1b-light-ring": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "rgb(235, 235, 235)"
        }
      ],
      "$type": "shadow",
      "$description": "Lighter ring for tabs, images — less contrast than level-1"
    },
    "level-2-subtle-card": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.04)"
        }
      ],
      "$type": "shadow",
      "$description": "Standard cards with minimal lift — ring + subtle elevation"
    },
    "level-3-full-card": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.04)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "8px",
          "spread": "-8px",
          "color": "rgba(0, 0, 0, 0.04)"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "#fafafa"
        }
      ],
      "$type": "shadow",
      "$description": "Featured cards — ring + elevation + ambient depth + inner #fafafa glow ring. Each layer serves a distinct architectural purpose"
    },
    "focus": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px",
          "color": "hsla(212, 100%, 48%, 1)"
        }
      ],
      "$type": "shadow",
      "$description": "Accessibility focus ring — keyboard focus on all interactive elements"
    },
    "input-focus": {
      "$value": [
        {
          "offsetX": "1px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "var(--ds-gray-alpha-600)"
        }
      ],
      "$type": "shadow",
      "$description": "Input field focus shadow"
    }
  },
  "motion": {
    "duration-fast": {
