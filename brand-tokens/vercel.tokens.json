{
  "$extensions": {
    "brand": "vercel",
    "source": "awesome-design-md",
    "aesthetic": "shadow-as-border philosophy, Geist font system, compression as identity",
    "key-characteristics": [
      "geist-typography",
      "shadow-as-border",
      "extreme-negative-tracking",
      "workflow-color-system"
    ]
  },
  "color": {
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Primary page background — pure white canvas"
    },
    "surface-subtle": {
      "$value": "#fafafa",
      "$type": "color",
      "$description": "Subtle surface tint, inner shadow highlight ring"
    },
    "text-primary": {
      "$value": "#171717",
      "$type": "color",
      "$description": "Primary text and headings — Vercel Black, not pure black for micro-warmth"
    },
    "text-secondary": {
      "$value": "#4d4d4d",
      "$type": "color",
      "$description": "Secondary text, description copy — Gray 600"
    },
    "accent": {
      "$value": "#000000",
      "$type": "color",
