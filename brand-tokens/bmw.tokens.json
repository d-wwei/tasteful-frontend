{
  "$extensions": {
    "brand": "bmw",
    "source": "awesome-design-md",
    "aesthetic": "automotive precision with industrial geometry",
    "key-characteristics": [
      "zero-border-radius",
      "light-weight-display",
      "showroom-lighting"
    ]
  },
  "color": {
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Primary surface \u2014 card backgrounds"
    },
    "surface-subtle": {
      "$value": "#f5f5f5",
      "$type": "color",
      "$description": "Light alternate surface"
    },
    "surface-dark": {
      "$value": "#1a1a1a",
      "$type": "color",
      "$description": "Dark hero sections"
    },
    "accent": {
      "$value": "#1c69d4",
      "$type": "color",
      "$description": "BMW Blue \u2014 singular interactive accent"
    },
    "accent-hover": {
      "$value": "#0653b6",
      "$type": "color",
      "$description": "BMW Focus Blue \u2014 active states"
    },
    "text-primary": {
      "$value": "#262626",
      "$type": "color",
      "$description": "Near Black \u2014 primary text"
    },
    "text-secondary": {
      "$value": "#757575",
      "$type": "color",
      "$description": "Meta Gray \u2014 secondary text"
    },
    "text-tertiary": {
      "$value": "#bbbbbb",
      "$type": "color",
      "$description": "Silver \u2014 tertiary text"
    },
    "text-on-dark": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "White text on dark backgrounds"
    },
    "text-on-accent": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "White on BMW Blue"
    },
    "error": {
      "$value": "#d30000",
      "$type": "color",
      "$description": "Error red"
    },
    "success": {
      "$value": "#007d48",
      "$type": "color",
      "$description": "Success green"
    },
    "border": {
      "$value": "#e0e0e0",
      "$type": "color",
      "$description": "Light border"
    }
  },
  "typography": {
    "font-display": {
      "$value": "BMWTypeNextLatin Light, Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Display/heading font"
    },
    "font-body": {
      "$value": "BMWTypeNextLatin, Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Body/UI font"
    },
    "scale-display": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Display \u2014 hero headlines"
    },
    "scale-section": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Section headings"
    },
    "scale-base": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Standard body"
    },
    "scale-caption": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "Captions"
    },
    "scale-small": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Small text"
    },
    "line-height-tight": {
      "$value": "1.15",
      "$type": "number",
      "$description": "Tight \u2014 headings"
    },
    "line-height-normal": {
      "$value": "1.50",
      "$type": "number",
      "$description": "Normal \u2014 body"
    },
    "weight-regular": {
      "$value": "400",
      "$type": "number",
      "$description": "Regular"
    },
    "weight-medium": {
      "$value": "500",
      "$type": "number",
      "$description": "Medium"
    },
    "weight-semibold": {
      "$value": "600",
      "$type": "number",
      "$description": "Semibold"
    }
  },
  "spacing": {
    "unit": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Base grid unit"
    },
    "xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Extra small"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Small"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Medium"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Large"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Extra large"
    },
    "2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Double extra large"
    },
    "section-gap": {
      "$value": "80px",
      "$type": "dimension",
      "$description": "Section spacing"
    },
    "container-max": {
      "$value": "1200px",
      "$type": "dimension",
      "$description": "Max container width"
    }
  },
  "border": {
    "radius-standard": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "Standard radius"
    },
    "radius-comfortable": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "Comfortable radius"
    },
    "radius-pill": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Pill shape"
    }
  },
  "shadow": {
    "level-0": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent"
        }
      ],
      "$type": "shadow",
      "$description": "Flat"
    },
    "level-1": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.08)"
        }
      ],
      "$type": "shadow",
      "$description": "Subtle elevation"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "150ms",
      "$type": "duration",
      "$description": "Quick interactions"
    },
    "duration-normal": {
      "$value": "200ms",
      "$type": "duration",
      "$description": "Standard transitions"
    },
    "easing-default": {
      "$value": [
        0.25,
        0.1,
        0.25,
        1
      ],
      "$type": "cubicBezier",
      "$description": "Standard ease"
    }
  },
  "breakpoint": {
    "mobile": {
      "$value": "640px",
      "$type": "dimension",
      "$description": "Mobile"
    },
    "tablet": {
      "$value": "768px",
      "$type": "dimension",
      "$description": "Tablet"
    },
    "desktop": {
      "$value": "1024px",
      "$type": "dimension",
      "$description": "Desktop"
    }
  }
}