    "slate-300": { "$value": "#cbd5e1", "$type": "color" },
    "slate-400": { "$value": "#94a3b8", "$type": "color" },
    "slate-500": { "$value": "#64748b", "$type": "color" },
    "slate-600": { "$value": "#475569", "$type": "color" },
    "slate-700": { "$value": "#334155", "$type": "color" },
    "slate-800": { "$value": "#1e293b", "$type": "color" },
    "slate-900": { "$value": "#0f172a", "$type": "color" },
