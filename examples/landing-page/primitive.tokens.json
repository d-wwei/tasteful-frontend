    "gray-800": { "$value": "#1e1f22", "$type": "color" },
    "gray-700": { "$value": "#28282c", "$type": "color" },
    "gray-600": { "$value": "#3e3e44", "$type": "color" },
    "gray-500": { "$value": "#62666d", "$type": "color" },
    "gray-400": { "$value": "#8a8f98", "$type": "color" },
    "gray-300": { "$value": "#d0d6e0", "$type": "color" },
    "gray-200": { "$value": "#e2e4e7", "$type": "color" },
    "gray-100": { "$value": "#f0f1f3", "$type": "color" },
    "gray-50": { "$value": "#f7f8f8", "$type": "color" },
    "white-alpha-2": { "$value": "rgba(255,255,255,0.02)", "$type": "color" },
