{
  "color": {
    "parchment-50": { "$value": "#faf8f5", "$type": "color", "$description": "Lightest parchment — card surfaces, elevated containers" },
    "parchment-100": { "$value": "#f5f4ed", "$type": "color", "$description": "Primary parchment — page background, the canvas" },
    "parchment-200": { "$value": "#f0eee6", "$type": "color", "$description": "Warm cream — borders, subtle dividers" },
    "parchment-300": { "$value": "#e8e6dc", "$type": "color", "$description": "Warm sand — interactive surfaces, prominent borders" },
    "parchment-400": { "$value": "#d1cfc5", "$type": "color", "$description": "Warm stone — ring shadows, muted interactive elements" },
    "parchment-500": { "$value": "#b0aea5", "$type": "color", "$description": "Warm silver — text on dark surfaces" },
    "parchment-600": { "$value": "#87867f", "$type": "color", "$description": "Stone gray — tertiary text, metadata" },
    "parchment-700": { "$value": "#5e5d59", "$type": "color", "$description": "Olive gray — secondary text, body copy" },
    "parchment-800": { "$value": "#3d3d3a", "$type": "color", "$description": "Dark warm — deep text, emphasized links" },
    "parchment-900": { "$value": "#2c2418", "$type": "color", "$description": "Near-black warm — dark section backgrounds" },
    "parchment-950": { "$value": "#141413", "$type": "color", "$description": "Deepest warm black — primary text, dark page bg" },
    "terracotta-400": { "$value": "#d97757", "$type": "color", "$description": "Coral — accent hover, lighter warm variant" },
    "terracotta-500": { "$value": "#c4654a", "$type": "color", "$description": "Terracotta brand — primary accent, CTAs" },
    "terracotta-600": { "$value": "#a8533b", "$type": "color", "$description": "Deep terracotta — pressed state, dark-mode accent" },
    "clay-400": { "$value": "#c2c0b6", "$type": "color", "$description": "Deep ring — active/pressed shadow ring" },
    "clay-500": { "$value": "#4d4c48", "$type": "color", "$description": "Charcoal warm — button text on light surfaces" },
    "clay-600": { "$value": "#30302e", "$type": "color", "$description": "Dark surface — dark section containers, nav borders" },
    "warm-white": { "$value": "#faf9f5", "$type": "color", "$description": "Ivory — card backgrounds on parchment" },
    "error": { "$value": "#b53333", "$type": "color", "$description": "Deep warm red — error state" },
    "success": { "$value": "#4d7c4d", "$type": "color", "$description": "Muted warm green — success state" },
    "focus": { "$value": "#3898ec", "$type": "color", "$description": "Cool blue — focus ring, only cool color in the system" }
  },
  "typography": {
    "font-display": {
      "$value": "Source Serif 4",
      "$type": "fontFamily",
      "$description": "Editorial serif for headlines — literary gravitas, weight 600-700"
    },
    "font-body": {
      "$value": "DM Sans",
      "$type": "fontFamily",
      "$description": "Clean geometric sans for body and UI text — weight 400-500"
    },
    "scale-xs": { "$value": "12px", "$type": "dimension" },
    "scale-sm": { "$value": "14px", "$type": "dimension" },
    "scale-base": { "$value": "16px", "$type": "dimension" },
    "scale-lg": { "$value": "18px", "$type": "dimension" },
    "scale-xl": { "$value": "24px", "$type": "dimension" },
    "scale-2xl": { "$value": "32px", "$type": "dimension" },
    "scale-3xl": { "$value": "48px", "$type": "dimension" },
    "line-height-tight": { "$value": "1.2", "$type": "number", "$description": "Display and large headings" },
    "line-height-heading": { "$value": "1.3", "$type": "number", "$description": "Standard headings" },
    "line-height-normal": { "$value": "1.5", "$type": "number", "$description": "UI text, captions" },
    "line-height-body": { "$value": "1.7", "$type": "number", "$description": "Body text — generous for reading comfort" },
    "weight-regular": { "$value": "400", "$type": "number" },
    "weight-medium": { "$value": "500", "$type": "number" },
    "weight-semibold": { "$value": "600", "$type": "number" },
    "weight-bold": { "$value": "700", "$type": "number" }
  },
  "spacing": {
    "unit": { "$value": "8px", "$type": "dimension", "$description": "Base grid unit" },
    "space-half": { "$value": "4px", "$type": "dimension", "$description": "Half grid unit — tight padding" },
    "space-1": { "$value": "8px", "$type": "dimension" },
    "space-1-5": { "$value": "12px", "$type": "dimension" },
    "space-2": { "$value": "16px", "$type": "dimension" },
    "space-3": { "$value": "24px", "$type": "dimension" },
    "space-4": { "$value": "32px", "$type": "dimension" },
    "space-6": { "$value": "48px", "$type": "dimension" },
    "space-8": { "$value": "64px", "$type": "dimension" },
    "space-10": { "$value": "80px", "$type": "dimension" },
    "space-12": { "$value": "96px", "$type": "dimension" }
  },
  "border": {
    "radius-sm": { "$value": "4px", "$type": "dimension", "$description": "Minimal — inline elements, tags" },
    "radius-md": { "$value": "8px", "$type": "dimension", "$description": "Standard — cards, containers" },
    "radius-lg": { "$value": "12px", "$type": "dimension", "$description": "Generous — buttons, inputs, featured elements" },
    "radius-full": { "$value": "9999px", "$type": "dimension", "$description": "Pill shape — avatars, badges" }
  },
  "shadow": {
    "ring-light": {
      "$value": [{ "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#f0eee6" }],
      "$type": "shadow",
      "$description": "Contained — 1px ring in border cream for cards on light background"
    },
    "ring-warm": {
      "$value": [{ "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#d1cfc5" }],
      "$type": "shadow",
      "$description": "Interactive — warm gray ring for hover states"
    },
    "ring-deep": {
      "$value": [{ "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#c2c0b6" }],
      "$type": "shadow",
      "$description": "Active — deeper warm ring for pressed states"
    },
    "ring-dark": {
      "$value": [{ "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#30302e" }],
      "$type": "shadow",
      "$description": "Contained — ring for cards on dark background"
    },
    "whisper": {
      "$value": [{ "offsetX": "0px", "offsetY": "4px", "blur": "24px", "spread": "0px", "color": "rgba(0,0,0,0.05)" }],
      "$type": "shadow",
      "$description": "Whisper elevation — barely visible lift for featured cards"
    },
    "lift": {
      "$value": [
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#d1cfc5" },
        { "offsetX": "0px", "offsetY": "4px", "blur": "24px", "spread": "0px", "color": "rgba(0,0,0,0.05)" }
      ],
      "$type": "shadow",
      "$description": "Hover lift — ring plus whisper elevation combined"
    }
  },
  "motion": {
    "duration-fast": { "$value": "150ms", "$type": "duration", "$description": "Micro-interactions — hover transitions" },
    "duration-normal": { "$value": "250ms", "$type": "duration", "$description": "Standard transitions — page elements" },
    "duration-slow": { "$value": "400ms", "$type": "duration", "$description": "Deliberate — section reveals, page enter" },
    "easing-default": {
      "$value": [0.16, 1, 0.3, 1],
      "$type": "cubicBezier",
      "$description": "Spring-like entrance — unhurried, literary pacing"
    },
    "easing-exit": {
      "$value": [0.4, 0, 1, 1],
      "$type": "cubicBezier",
      "$description": "Quick exit — clean departure"
    },
    "easing-gentle": {
      "$value": [0.25, 0.1, 0.25, 1],
      "$type": "cubicBezier",
      "$description": "Gentle ease — smooth content transitions"
    }
  }
}