    "duration-slow": { "$value": "350ms", "$type": "duration", "$description": "Chart animations, modal entrance" },
    "easing-default": {
      "$value": [0.25, 0.1, 0.25, 1],
      "$type": "cubicBezier",
      "$description": "Standard ease -- smooth and predictable"
    },
    "easing-entrance": {
      "$value": [0.0, 0.0, 0.2, 1],
      "$type": "cubicBezier",
      "$description": "Elements entering view"
    }
  }
