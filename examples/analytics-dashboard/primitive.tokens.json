    "weight-medium": { "$value": "500", "$type": "number" },
    "weight-semibold": { "$value": "600", "$type": "number" },
    "weight-bold": { "$value": "700", "$type": "number" }
  },
  "spacing": {
    "unit": { "$value": "4px", "$type": "dimension", "$description": "Base grid unit -- 4px for dense analytics layouts" },
    "space-0.5": { "$value": "2px", "$type": "dimension" },
    "space-1": { "$value": "4px", "$type": "dimension" },
    "space-2": { "$value": "8px", "$type": "dimension" },
    "space-3": { "$value": "12px", "$type": "dimension" },
    "space-4": { "$value": "16px", "$type": "dimension" },
    "space-5": { "$value": "20px", "$type": "dimension" },
    "space-6": { "$value": "24px", "$type": "dimension" },
    "space-8": { "$value": "32px", "$type": "dimension" },
    "space-12": { "$value": "48px", "$type": "dimension" }
  },
  "border": {
    "radius-sm": { "$value": "4px", "$type": "dimension", "$description": "Badges, inline code, chips" },
    "radius-md": { "$value": "6px", "$type": "dimension", "$description": "Buttons, inputs, dropdowns -- workhorse radius" },
    "radius-lg": { "$value": "8px", "$type": "dimension", "$description": "Cards, modals, dashboard tiles" },
    "radius-pill": { "$value": "9999px", "$type": "dimension", "$description": "Pill badges, status indicators" }
  },
  "shadow": {
    "shadow-sm": {
      "$value": [{ "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgba(0,0,0,0.12)" }],
      "$type": "shadow",
      "$description": "Subtle lift -- dropdowns, tooltips only. PostHog uses borders, not shadows."
    }
  },
  "motion": {
    "duration-instant": { "$value": "75ms", "$type": "duration", "$description": "Toggle switches, checkbox ticks" },
    "duration-fast": { "$value": "150ms", "$type": "duration", "$description": "Hover states, button press, tab switch" },
